# Copy this file to .env.local and fill in your real Supabase project values.
# Find both at: Supabase Dashboard -> your project -> Project Settings -> API.
# .env.local is already gitignored — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public address of the site, used for auth redirects (Google login callback,
# email confirmation, password reset). Production: https://www.greenpagespk.com
# (set in cPanel's Node.js app page). Leave it UNSET locally — in development
# the request's own origin / http://localhost:3000 is used automatically.
# In production it falls back to lib/site.js's SITE_URL, never to localhost.
NEXT_PUBLIC_SITE_URL=https://www.greenpagespk.com
